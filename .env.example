# Copy to .env.local and fill in. Both values are safe for the browser:
# the anon key grants nothing until a user signs in, because row level
# security scopes every table to auth.uid().
#
# NEVER put the service_role key in this file or anywhere in src/ —
# it bypasses RLS entirely and belongs only on a trusted server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
