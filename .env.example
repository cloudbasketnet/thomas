# Copy to .env.local and fill in. Both values are safe for the browser:
# the anon key grants nothing until a user signs in, because row level
# security scopes every table to auth.uid().
#
# NEVER put the service_role key in this file or anywhere in src/ —
# it bypasses RLS entirely and belongs only on a trusted server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables scanning a bill photo into purchases on the Purchases page.
# Get a key at https://aistudio.google.com/apikey
#
# WARNING: like the Supabase anon key, this ships inside the browser bundle and
# can be read by anyone who opens the app — but unlike the anon key it is NOT
# protected by row level security, so it can be used to spend your Gemini quota.
# Restrict it to the Generative Language API, and move the call behind a server
# (e.g. a Supabase Edge Function) before deploying anywhere public.
VITE_GEMINI_API_KEY=your-gemini-api-key
# VITE_GEMINI_MODEL=gemini-3.6-flash
